# .env.example
APP_NAME=IntellAudioInferenceRetrieval
APP_ENV=development
LOG_LEVEL=INFO

# Data Storage
DATA_DIR=data
DATABASE_URL=sqlite:///data/db/system.db

# Audio Processing
SAMPLE_RATE=16000
CHANNELS=1

# V3 ASR (Whisper) Configuration
ASR_ENGINE=whisper
WHISPER_MODEL_SIZE=base.en
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_BEAM_SIZE=5

# V3 Voice Activity Detection (VAD)
VAD_ENGINE=silero
VAD_THRESHOLD=0.5
VAD_MIN_SPEECH_DURATION_MS=250
VAD_MIN_SILENCE_DURATION_MS=300
VAD_SPEECH_PAD_MS=100

# V3 Speaker Representation / Voice Embeddings
SPEAKER_EMBEDDING_ENGINE=speechbrain
SPEAKER_EMBEDDING_MODEL=speechbrain/spkrec-ecapa-voxceleb
SPEAKER_EMBEDDING_DEVICE=auto
SPEAKER_MIN_SEGMENT_DURATION_SEC=0.5

# V3 Acoustic Feature Extraction
EXTRACT_ACOUSTICS=true

# LM Studio Integration
LM_STUDIO_BASE_URL=http://localhost:1234
LM_STUDIO_CHAT_MODEL=qwen3-8b
LM_STUDIO_EMBEDDING_MODEL=text-embedding-qwen3-embedding-0.6b
LM_STUDIO_TIMEOUT=120.0

# Qdrant Vector Store
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=intell_audio_chunks
VECTOR_STORE=qdrant
ALLOW_LEXICAL_FALLBACK=false

# Transcript Chunking
CHUNK_SIZE_WORDS=60
CHUNK_OVERLAP_WORDS=10

# RAG & Grounded Retrieval Parameters
RAG_TOP_K=10
RAG_FINAL_K=5
RAG_MIN_RELEVANCE_SCORE=0.3
RAG_REQUIRE_EVIDENCE=true
RAG_ALLOW_UNGROUNDED_ANSWER=false
EXPAND_ADJACENT_CONTEXT=true

# API Server Settings
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit Settings
STREAMLIT_PORT=8501
