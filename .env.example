# .env.example
APP_NAME=IntellAudioInferenceRetrieval
APP_ENV=development
LOG_LEVEL=INFO

# Data Storage
DATA_DIR=data

# Services & Integrations
GENTLE_URL=http://localhost:8888/transcriptions?async=false
DATABASE_URL=sqlite:///data/db/system.db

# Engine Configurations
ASR_ENGINE=pocketsphinx
ASR_MODEL=default
ALIGNMENT_ENGINE=gentle
RETRIEVAL_ENGINE=lexical

# LM Studio Integration
LM_STUDIO_BASE_URL=http://localhost:1234
LM_STUDIO_CHAT_MODEL=qwen3-8b
LM_STUDIO_EMBEDDING_MODEL=text-embedding-qwen3-embedding-0.6b
LM_STUDIO_TIMEOUT=120.0

# Qdrant Vector Store
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=intell_audio_chunks
VECTOR_STORE=qdrant
ALLOW_LEXICAL_FALLBACK=false

# Transcript Chunking
CHUNK_SIZE_WORDS=60
CHUNK_OVERLAP_WORDS=10

# RAG & Grounded Retrieval Parameters
RAG_TOP_K=10
RAG_FINAL_K=5
RAG_MIN_RELEVANCE_SCORE=0.3
RAG_REQUIRE_EVIDENCE=true
RAG_ALLOW_UNGROUNDED_ANSWER=false
EXPAND_ADJACENT_CONTEXT=true

# Phase 7A Speaker & Content Intelligence
DIARIZATION_ENGINE=heuristic
DIARIZATION_MIN_SILENCE_MS=800
DIARIZATION_PAUSE_THRESHOLD_DB=-40.0

ENABLE_CONTENT_ANALYSIS=false
CONTENT_ANALYSIS_BATCH_SIZE=10
MAX_CONTENT_ANALYSIS_CHARS=8000
CONTENT_ANALYSIS_MAX_RETRIES=2

ENABLE_CHAPTER_GENERATION=true
CHAPTER_MIN_PAUSE_SEC=3.0
CHAPTER_DISCONTINUITY_THRESHOLD=0.3
CHAPTER_MAX_COUNT=20

# Phase 7B Intent-Aware Retrieval & Temporal Context
ENABLE_QUERY_UNDERSTANDING=true
QUERY_UNDERSTANDING_LLM_FALLBACK=false

RAG_CONTEXT_WINDOW_BEFORE=1
RAG_CONTEXT_WINDOW_AFTER=2
RAG_CONTEXT_MAX_WINDOW_CHUNKS=5

RERANK_WEIGHT_VECTOR=0.40
RERANK_WEIGHT_BM25=0.30
RERANK_WEIGHT_OVERLAP=0.30
RERANK_WEIGHT_CONTENT=0.0
RERANK_WEIGHT_ACTION=0.0
RERANK_WEIGHT_OBJECT=0.0
RERANK_WEIGHT_TARGET=0.0
RERANK_WEIGHT_RELATION=0.0

# API Server Settings
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit Settings
STREAMLIT_PORT=8501


